DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
FAISS_INDEX_PATH=data/faiss.index

# Chunking
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=50

# Retrieval
SEARCH_TOP_K=20
SEARCH_CONTEXT_CHUNKS=8
PERSON_BOOST=0.10

# LLM: "ollama" (local, default) or "groq" (free API)
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60

# Local model via Ollama (see docs/LOCAL_SETUP.md)
# 8 GB RAM: llama3.2:3b or qwen2.5:3b | 16 GB+: llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional cloud fallback; check Groq's current model list, names change over time
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fetching
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_RETRIES=2
PLAYWRIGHT_FALLBACK=True
MIN_TEXT_CHARS=500

# Background worker (Huey). Thread workers, not process workers: process mode is
# unreliable on Windows. Keep this at 1 so FAISS writes stay serialized.
HUEY_WORKERS=1
